// Reference consumers of the neighbour grid: count every particle's neighbours, and mark the neighbours of one
// picked particle. Both are the loop documented in src/wgsl/neighbors.wgsl, unchanged. `neighbor_bindings.wgsl`
// is generated by NeighborGrid.chunks({ binding: 2 }).

#include "neighbor_bindings.wgsl"

@group(0) @binding(0) var<storage, read> positions: array<vec4f>;
// One f32 per particle: the neighbour count, or the highlight value of the marking kernel.
@group(0) @binding(1) var<storage, read_write> result: array<f32>;
// The particle to highlight (index into positions); a value >= the particle count means "none".
@group(0) @binding(5) var<storage, read> pick: array<u32>;

@compute @workgroup_size(64)
fn count_neighbors(@builtin(global_invocation_id) id: vec3u) {
  let i = id.x;
  if (i >= arrayLength(&result)) { return; }
  let p = positions[i].xyz;
  let c = neighbor_cell_of(neighbor_grid, p);
  let r2 = neighbor_grid.radius * neighbor_grid.radius;
  var n = 0u;
  for (var row = 0u; row < neighbor_grid.rows; row++) {
    let span = neighbor_row_span(c, row);
    for (var k = span.x; k < span.y; k++) {
      let j = neighbor_particle(k);
      if (j != i && neighbor_dist2(neighbor_grid, positions[j].xyz - p) <= r2) {
        n++;
      }
    }
  }
  result[i] = f32(n);
}

// One invocation: walk the picked particle's neighbours and write 1 for each, 2 for the particle itself.
// `result` must be zeroed first. The marks come from the grid, so a hole in the highlighted ball is a bug.
@compute @workgroup_size(1)
fn mark_neighbors() {
  let i = pick[0];
  if (i >= arrayLength(&result)) { return; }
  let p = positions[i].xyz;
  let c = neighbor_cell_of(neighbor_grid, p);
  let r2 = neighbor_grid.radius * neighbor_grid.radius;
  for (var row = 0u; row < neighbor_grid.rows; row++) {
    let span = neighbor_row_span(c, row);
    for (var k = span.x; k < span.y; k++) {
      let j = neighbor_particle(k);
      if (neighbor_dist2(neighbor_grid, positions[j].xyz - p) <= r2) {
        result[j] = 1.0;
      }
    }
  }
  result[i] = 2.0;
}
