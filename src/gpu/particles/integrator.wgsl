// The ready-made particle integrator: semi-implicit (symplectic) Euler with gravity, linear damping, an
// optional force field, a bounding box with restitution and friction, and optional respawning of particles whose
// life ran out. Particles do not interact, so it updates positions and velocities in place and runs several
// fixed sub-steps inside one dispatch (see integrator.ts for the contract).
//
// Includes, both generated by integrator.ts:
//   integrator_params.wgsl   struct IntegratorParams (the uniform block)
//   force_field.wgsl         fn force_field(p: vec3f, v: vec3f, time: f32, index: u32) -> vec3f, an acceleration

#include "particles.wgsl"
#include "integrator_params.wgsl"
#include "force_field.wgsl"

@group(0) @binding(0) var<uniform> params: IntegratorParams;
@group(0) @binding(1) var<storage, read_write> positions: array<vec4f>;
@group(0) @binding(2) var<storage, read_write> velocities: array<vec4f>;

@compute @workgroup_size(64)
fn main(@builtin(global_invocation_id) id: vec3u) {
  let i = id.x;
  if (i >= params.count) { return; }

  var pw = positions[i];
  var vw = velocities[i];
  var p = pw.xyz;
  var v = vw.xyz;
  var life = vw.w;
  var accel = vec3f(0.0);
  let drag = exp(-params.damping * params.dt);
  let lo = params.bounds_min + vec3f(params.margin);
  let hi = params.bounds_max - vec3f(params.margin);
  let axes = select(3u, 2u, params.dimension == 2u);

  for (var s = 0u; s < params.steps; s++) {
    let t = params.time + f32(s) * params.dt;

    if (params.respawn != 0u && !(life > 0.0)) {
      let a = particle_random_3d(i, params.seed * 64u + s);
      let b = particle_random_3d(i ^ 0x68e31da4u, params.seed * 64u + s);
      p = particle_emit_position(params.emit_shape, params.emit_center, params.emit_extent, a, params.dimension);
      v = particle_emit_velocity(params.emit_direction, params.emit_speed, params.emit_spread, params.emit_jitter, b, params.dimension);
      life = mix(params.life_min, params.life_max, a.z);
    }

    // The field is the expensive part: refresh it every field_every sub-steps and reuse it between.
    if (s % params.field_every == 0u) {
      accel = params.gravity + force_field(p, v, t, i);
    }
    v += accel * params.dt;
    v *= drag;
    p += v * params.dt;

    if (params.use_bounds != 0u) {
      var hit = false;
      for (var k = 0u; k < axes; k++) {
        if (p[k] < lo[k]) {
          p[k] = lo[k] + (lo[k] - p[k]) * params.restitution;
          v[k] = abs(v[k]) * params.restitution;
          hit = true;
          if (k == 1u && params.kill_floor != 0u) { life = 0.0; }
        } else if (p[k] > hi[k]) {
          p[k] = hi[k] - (p[k] - hi[k]) * params.restitution;
          v[k] = -abs(v[k]) * params.restitution;
          hit = true;
        }
      }
      if (hit && params.friction > 0.0) {
        // Contact drags the whole velocity a little, which is what keeps a pile of particles from sliding forever.
        v *= 1.0 - params.friction;
      }
    }

    if (params.respawn != 0u) {
      life -= params.dt;
    }
  }

  if (params.dimension == 2u) {
    p.z = 0.0;
    v.z = 0.0;
  }
  positions[i] = vec4f(p, select(pw.w, length(v), params.write_speed != 0u));
  velocities[i] = vec4f(v, select(vw.w, life, params.respawn != 0u));
}
